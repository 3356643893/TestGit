# .env.example —— 复制为 .env 后填入真实值，.env 不要提交到 Git

# ===== 当前激活环境 =====
APP_ENV=test

# ===== 数据库凭证（按环境区分，_apply_env_overrides 会自动匹配当前 APP_ENV） =====
TEST_DB_USER=your_test_db_user
TEST_DB_PASSWORD=your_test_db_password

STAGING_DB_USER=your_staging_db_user
STAGING_DB_PASSWORD=your_staging_db_password

PROD_DB_USER=your_prod_db_user
PROD_DB_PASSWORD=your_prod_db_password

# 兜底（可选，如果上面分环境变量都没配，会 fallback 到这里）
DB_USER=your_fallback_db_user
DB_PASSWORD=your_fallback_db_password

# ===== 邮件告警 SMTP 授权码 =====
SMTP_PASSWORD=your_smtp_authorization_code

# ===== 企业 IM 告警 Webhook =====
LARK_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxx
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxxxx

# ===== 应用级 Token =====
APP_TOKEN=your_app_token_here
