# ============================================================
# 环境差异配置（Layer 2: 每个环境只写"和默认值不同的部分"）
#
# 【配置加载链】
#   config/defaults.yaml  ← 框架默认值（viewport / retry / db pool ...）
#   ↓ deep_merge
#   config/env.yaml       ← 本文件，仅写差异
#   ↓ 敏感凭证覆盖
#   .env 文件              ← DB_USER / DB_PASSWORD / SMTP_PASSWORD
#
# 【环境切换优先级】
#   1. 命令行: pytest --env=prod
#   2. 环境变量: APP_ENV=prod
#   3. 本文件 env 字段
#
# 为什么这么设计？
#   → 改全局 viewport 只改 defaults.yaml，不碰 env.yaml
#   → 新人看 env.yaml 一眼知道"每个环境到底有什么不同"
#   → Git diff 干净，不会因为无关改动产生噪音
# ============================================================

env: test

environment:

  # ===== 本地开发 / 单元测试 =====
  test:
    base_url: "http://127.0.0.1:8080/api"
    ui_base_url: "http://127.0.0.1:8080"
    timeout: 10
    db:
      host: "127.0.0.1"
      port: 3306
      database: "test_api_db"
    # ↑ 凭证由 .env 的 TEST_DB_USER / TEST_DB_PASSWORD 注入
    mock:
      enabled: true          # 本地开发开 Mock

  # ===== 预发 / 回归 =====
  staging:
    base_url: "https://staging-api.xxx.com"
    ui_base_url: "https://staging.xxx.com"
    timeout: 15
    db:
      host: "staging-db.xxx.com"
      port: 3306
      database: "staging_api_db"
      pool_size: 10          # 回归环境量大，加大连接池
      max_overflow: 20
    retry:
      max_attempts: 2
      wait_seconds: 2
    ui:
      default_timeout: 20000

  # ===== 生产冒烟（只读账号 + 严格阈值） =====
  prod:
    base_url: "https://api.xxx.com"
    ui_base_url: "https://xxx.com"
    timeout: 20
    db:
      host: "prod-db.xxx.com"
      port: 5432
      driver: "postgresql"   # 生产用 PG，覆盖 defaults 的 mysql
      database: "prod_api_db_smoke"
      pool_size: 3
      max_overflow: 5
    retry:
      max_attempts: 2
      wait_seconds: 3
    token_pool:
      default_expiry: 1800   # 生产 token 有效期短，覆盖默认 3600
    performance:
      p95_response_ms: 5000  # 生产阈值更严，覆盖默认 3000
      p99_response_ms: 10000
      error_rate: 0.005
    log:
      log_level: "WARNING"   # 生产减少日志噪音

# ---------- 全局敏感配置（各环境通用，但不进 Git） ----------
# 以下字段的具体值建议全部移到 .env 中，Config 会自动覆盖：
#   TEST_DB_USER / TEST_DB_PASSWORD
#   STAGING_DB_USER / STAGING_DB_PASSWORD
#   PROD_DB_USER / PROD_DB_PASSWORD
#   DB_USER / DB_PASSWORD  (全局兜底)
#   SMTP_PASSWORD
#   APP_TOKEN
global:
  notify:
    mail_to:
      - "your_email@qq.com"
    mail_from: "your_email@qq.com"